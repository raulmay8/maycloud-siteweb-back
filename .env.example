NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:4321
CORS_ALLOWED_ORIGINS=http://localhost:4321,https://maycloud.mx
SWAGGER_ENABLED=true
# Vacío al ejecutar directamente en el host; /host dentro del contenedor.
SERVER_HOST_ROOT=
# Socket local del host o ruta montada dentro del contenedor del backend.
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Raíz operativa montada como solo lectura; vacía desactiva el explorador.
SERVER_DIRECTORIES_ROOT=
SERVER_DIRECTORIES_NAME=MayCloud
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost,maycloud.mx
TURNSTILE_EXPECTED_ACTION=contact
# ADMIN_EMAIL=admin@maycloud.com
# ADMIN_PASSWORD=replace-with-a-strong-password
