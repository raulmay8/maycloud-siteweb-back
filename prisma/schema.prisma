generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// Acciones anónimas que se pueden registrar durante una visita al sitio.
/// Se agregan nuevos valores conforme se incorporen métricas adicionales.
enum AnalyticsEventType {
  CONTACT_FORM_INTERACTION
}

/// Representa una visita al sitio. El id numérico se usa únicamente para
/// relaciones internas; sessionToken es el identificador seguro que podrá
/// almacenarse en la cookie y recibirse desde el cliente.
model AnalyticsSession {
  id             BigInt           @id @default(autoincrement()) @db.BigInt
  sessionToken   String           @unique @default(uuid()) @map("session_token") @db.Uuid
  /// Identificador anónimo persistente del navegador. Es opcional para poder
  /// respetar visitas en las que no se permita una cookie persistente.
  visitorToken   String?          @map("visitor_token") @db.Uuid
  landingPath    String           @map("landing_path") @db.VarChar(500)
  /// Solo se conserva el host de referencia, no la URL completa, para evitar
  /// almacenar parámetros que pudieran contener información sensible.
  referrerHost   String?          @map("referrer_host") @db.VarChar(255)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  events         AnalyticsEvent[]

  @@index([startedAt])
  @@index([visitorToken, startedAt])
  @@map("analytics_sessions")
}

/// Registra una acción relevante dentro de una sesión. eventToken permite
/// hacer idempotentes los reintentos sin exponer el id numérico interno.
model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement()) @db.BigInt
  eventToken String             @unique @default(uuid()) @map("event_token") @db.Uuid
  sessionId  BigInt             @map("session_id") @db.BigInt
  type       AnalyticsEventType
  pagePath   String             @map("page_path") @db.VarChar(500)
  occurredAt DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  session    AnalyticsSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Impide contar más de una vez el mismo tipo de interacción por sesión.
  /// Si un evento futuro debe repetirse, habrá que especializar esta restricción.
  @@unique([sessionId, type])
  @@index([type, occurredAt])
  @@map("analytics_events")
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(120)
  email     String               @db.VarChar(255)
  subject   String               @db.VarChar(160)
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  firstName     String?        @map("first_name") @db.VarChar(100)
  lastName      String?        @map("last_name") @db.VarChar(100)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles       RolePermission[]
  menus       Menu[]

  @@map("permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Menu {
  id           String      @id @default(uuid()) @db.Uuid
  key          String      @unique @db.VarChar(100)
  label        String      @db.VarChar(120)
  route        String?     @db.VarChar(255)
  icon         String?     @db.VarChar(80)
  sortOrder    Int         @default(0) @map("sort_order")
  isActive     Boolean     @default(true) @map("is_active")
  parentId     String?     @map("parent_id") @db.Uuid
  permissionId String?     @map("permission_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent       Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Menu[]      @relation("MenuHierarchy")
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([parentId, sortOrder])
  @@index([permissionId])
  @@map("menus")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(3)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
